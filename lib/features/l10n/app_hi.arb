  "acceptanceTermsContent": "प्लेटफ़ॉर्म तक पहुँचने या उपयोग करने से, आप इन नियमों और शर्तों और हमारी गोपनीयता नीति से बंधे होने के लिए सहमत होते हैं।",
  "eligibilityContent": "हमारी सेवाओं को पंजीकृत करने और उपयोग करने के लिए आपकी आयु कम से कम 18 वर्ष और कानूनों के अनुसार कानूनी विवाह योग्य आयु होनी चाहिए।",
  "accountRegistrationContent": "कुछ सुविधाओं का उपयोग करने के लिए, आपको एक खाते के लिए पंजीकरण करना होगा। आप सटीक और पूर्ण जानकारी प्रदान करने के लिए सहमत हैं।",
  "userConductContent": "आप केवल वैध उद्देश्यों के लिए और इस तरह से सेवा का उपयोग करने के लिए सहमत हैं जिससे दूसरों के अधिकारों का उल्लंघन न हो।",
  "contentOwnershipContent": "आप अपने द्वारा सबमिट की गई सामग्री के सभी स्वामित्व अधिकार सुरक्षित रखते हैं। सबमिट करके, आप हमें इसका उपयोग करने का लाइसेंस देते हैं।",
  "premiumServicesContent": "हम प्रीमियम सेवाएं की पेशकश कर सकते हैं जिनके लिए भुगतान की आवश्यकता होती है। जब तक अन्यथा न कहा जाए, सभी शुल्क गैर-वापसी योग्य हैं।",
  "disclaimerWarrantiesContent": "सेवा \"जैसा है\" आधार पर प्रदान की जाती है। हम कोई वारंटी नहीं देते हैं, व्यक्त या निहित।",
  "limitationLiabilityContent": "किसी भी स्थिति में हम सामग्री के उपयोग या उपयोग करने में असमर्थता से उत्पन्न होने वाले किसी भी नुकसान के लिए उत्तरदायी नहीं होंगे।",
  "indemnificationContent": "आप सेवा के अपने उपयोग से संबंधित किसी भी नुकसान या लागत से हमें क्षतिपूर्ति करने और हानिरहित रखने के लिए सहमत हैं।",
  "changesTermsContent": "हम किसी भी समय इन शर्तों को बदलने का अधिकार सुरक्षित रखते हैं। आपका निरंतर उपयोग स्वीकृति दर्शाता है।",
  "contactUsContent": "हम इन शर्तों के संबंध में आपके प्रश्नों या टिप्पणियों का स्वागत करते हैं।",
